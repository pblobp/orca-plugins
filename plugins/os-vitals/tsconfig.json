{
  "extends": "./.orca/types/tsconfig.json",
  "compilerOptions": {
    "typeRoots": ["./.orca/types", "../../node_modules/@types"],
    "types": [
      "orca",
      "orca-host",
      "orca-frame",
      "orca-worker",
      "orca-services",
      "orca-testing",
      "node"
    ],
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "panel"]
}
